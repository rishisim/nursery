+    def _image_to_png_data_url(self, image: str | Image.Image) -> str:
+        """Normalize supported image inputs to a correctly labelled PNG data URL."""
+        if isinstance(image, Image.Image):
+            loaded = image
+        elif image.startswith("data:"):
+            _, encoded = image.split(",", 1)
+            loaded = Image.open(BytesIO(base64.b64decode(encoded)))
+        elif os.path.splitext(image)[-1].lower() in self.image_formats:
+            if not os.path.exists(image):
+                raise FileNotFoundError(f"Image file not found: {image}")
+            loaded = Image.open(image)
+        else:
+            loaded = Image.open(BytesIO(base64.b64decode(image)))
+
+        buffer = BytesIO()
+        loaded.convert("RGB").save(buffer, format="PNG")
+        encoded = base64.b64encode(buffer.getvalue()).decode("utf-8")
+        return f"data:image/png;base64,{encoded}"
+
