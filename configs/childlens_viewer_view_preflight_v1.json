{
  "schema": "ChildLensViewerViewCalibrationPreflight.v1",
  "frozen_before_childlens_viewer_view_scoring": true,
  "scientific_role": "provisional_model_derived_viewer_view_calibration_from_naturalistic_child_centered_ages_3_to_5_data_not_final_infant_calibration",
  "scope": {
    "sole_empirical_child_source": "ChildLens",
    "excluded_empirical_ancestry": ["AEA", "BabyView"],
    "selected_joint_estimator": "ReViV",
    "predeclared_independent_geometry_validator": "ViPE",
    "estimator_switching_after_outcome": false,
    "final_lexical_or_cue_lift_evaluation": false,
    "new_atomic_task_families": false,
    "diffusion_appearance_bakeoff": false
  },
  "instrument_pins": {
    "reviv": {
      "repository": "https://github.com/lvsean/reviv4d",
      "commit": "de23a67009685e3878e4bad49d33f023d4b7a085",
      "code_license": "Apache-2.0",
      "weight_license": "Sample Code License; non-commercial research only",
      "official_environment": "Python 3.12, PyTorch 2.6.0 CUDA 12.4, torchvision 0.21.0, torch-scatter CUDA wheel",
      "context": "2 seconds; metric pathway resamples to 32 frames at 16 fps and 512x512"
    },
    "vipe": {
      "repository": "https://github.com/nv-tlabs/vipe",
      "commit": "95a8816947602ddc26fcb7a80bea4f9313059578",
      "code_license": "Apache-2.0 except separately licensed optional components",
      "runtime": "GPU-oriented CUDA pipeline including CUDA fused kernels and cuVSLAM",
      "metric_boundary": "camera motion and dense near-metric depth are model estimates; similarity or scale alignment is required where appropriate"
    }
  },
  "sampling": {
    "unit": "participant-distinct recording, summarized from overlapping local 2-second windows",
    "authoritative_existing_sample": {
      "count": 30,
      "participant_distinct": true,
      "binding": "output/nursery_program_convergence_v1/childlens_30_video_extension_v1_8/selection_and_admission_receipt.json",
      "reuse_without_duplicate_acquisition": true
    },
    "canary_recording_count": 5,
    "canary_selection": "content-blind deterministic participant-key hash order inside restricted quarantine",
    "window_seconds": 2.0,
    "window_stride_seconds": 1.0,
    "minimum_usable_windows_per_recording": 12,
    "expansion": "only after every simulator-instrument and ChildLens-canary gate passes; expand to the already frozen 30 participant-distinct recordings; no additional drive recordings in v1"
  },
  "quantities": {
    "camera": ["angular_velocity", "angular_acceleration", "translation_up_to_valid_alignment", "dwell_duration", "turn_duration", "turn_rate", "power_spectrum", "lag_autocorrelation"],
    "viewer": ["gaze_stability", "gaze_turn_rate", "hand_visibility", "hand_relative_velocity", "hand_relative_acceleration"],
    "geometry": ["robust_depth_change", "depth_interquartile_range", "scene_geometry_change"],
    "coupling": ["camera_hand_cross_correlation", "camera_activity_event_lag", "hand_activity_event_lag"],
    "absolute_trajectory_policy": "do not interpret stitched 30-second absolute trajectories as reliable; aggregate aligned local derivatives and events"
  },
  "validation": {
    "simulator_ground_truth": {
      "rotation_error_degrees_median_max": 5.0,
      "rotation_error_degrees_p90_max": 12.0,
      "angular_speed_spearman_min": 0.8,
      "turn_event_f1_min": 0.75,
      "translation_direction_cosine_median_min": 0.8,
      "translation_speed_spearman_after_scale_alignment_min": 0.7,
      "depth_abs_rel_after_per_window_scale_alignment_max": 0.2,
      "hand_visibility_f1_min": 0.8,
      "hand_relative_speed_spearman_min": 0.65
    },
    "overlap_consistency": {
      "shared_frame_rotation_degrees_median_max": 3.0,
      "shared_frame_rotation_degrees_p90_max": 8.0,
      "aligned_translation_correlation_min": 0.85,
      "depth_log_ratio_mad_max": 0.15,
      "gaze_degrees_median_max": 5.0,
      "hand_joint_normalized_median_max": 0.1
    },
    "preprocessing_perturbations": {
      "variants": ["fps_24", "fps_30", "resolution_256", "resolution_512", "center_crop_90pct"],
      "angular_speed_relative_median_change_max": 0.15,
      "turn_rate_relative_change_max": 0.2,
      "depth_summary_relative_median_change_max": 0.2,
      "hand_visibility_absolute_change_max": 0.1
    },
    "reviv_vipe_agreement": {
      "rotation_increment_degrees_median_max": 5.0,
      "rotation_increment_degrees_p90_max": 12.0,
      "translation_direction_cosine_median_min": 0.75,
      "translation_speed_spearman_after_scale_alignment_min": 0.7,
      "depth_log_ratio_mad_after_scale_alignment_max": 0.2
    },
    "missingness": {
      "recording_usable_window_fraction_min": 0.8,
      "canary_usable_recording_fraction_min": 0.8,
      "quantity_recording_coverage_min": 0.8,
      "abstain_on_nonfinite_or_failed_alignment": true,
      "no_imputation_for_primary_quantities": true
    },
    "decision_rule": "conjunctive: every required simulator, overlap, perturbation, agreement, and missingness threshold must pass; no threshold tuning after ChildLens outcomes"
  },
  "uncertainty_and_export": {
    "recording_summary": "median plus interquartile range of usable windows",
    "population_summary": "unweighted across participant-distinct recordings",
    "interval": "participant-cluster bootstrap 90 percent interval, 10000 replicates, seed 20260726",
    "minimum_export_cell_count": 5,
    "outward_rounding": "two significant decimal places",
    "permitted": ["aggregate distributions", "missingness rates", "gate statistics", "instrument and protocol provenance"],
    "forbidden": ["raw media", "frames", "audio", "filenames", "paths", "participant keys", "timestamps", "window rows", "embeddings", "model outputs containing reconstructable content"]
  },
  "hardware_gate": {
    "requires_local_nvidia_cuda": true,
    "minimum_cuda_runtime": "12.4",
    "both_official_instruments_must_run_on_the_same_privacy_compliant_local_compute_boundary": true,
    "remote_private_media_execution": false,
    "stop_if_unavailable": "STOP_HARDWARE_PRIVACY_NO_LOCAL_CUDA"
  },
  "controller_if_all_measurement_gates_pass": {
    "change": "small action-coupled structured dwell_turn_reach_reorientation repair with event-linked higher-frequency residuals",
    "independent_random_jitter": false,
    "evaluation_episode_count": 10,
    "matched_existing_object_play_families": true,
    "preserve": ["physics", "synchronization", "camera_truth", "IMU", "proprioception", "contact", "object_state", "lexical_event_timing"]
  }
}
